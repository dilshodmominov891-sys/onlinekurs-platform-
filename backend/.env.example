# Flask / login
SECRET_KEY=PASTE_A_LONG_RANDOM_SECRET
ADMIN_LOGIN=admin
ADMIN_PASSWORD=PASTE_A_STRONG_ADMIN_PASSWORD
TEACHER_LOGIN=teacher
TEACHER_PASSWORD=PASTE_A_STRONG_TEACHER_PASSWORD
LIVE_ROOM_PASSWORD=PASTE_A_STRONG_LIVE_PASSWORD

# Frontend domains allowed to use cookies and Socket.IO.
# After Netlify deploy, replace the example URL with your real URL.
CORS_ORIGINS=http://localhost:5173,https://YOUR-SITE.netlify.app
COOKIE_SECURE=1
COOKIE_SAMESITE=None

# Railway PostgreSQL automatically provides DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Optional integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LINK=https://t.me/YOUR_USERNAME
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Upload settings
MAX_UPLOAD_MB=300
# Set this only when a persistent disk/volume is mounted.
# UPLOAD_DIR=/app/backend/uploads
